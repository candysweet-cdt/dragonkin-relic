{
    "format_version": "1.8.0",
    "minecraft:spawn_rules": {
        "description": {
            "identifier": "fycq:dragon_priest",
            "population_control": "monster"
        },
        "conditions": [
            {
                "minecraft:spawns_on_surface": {},
                "minecraft:brightness_filter": {
                    "min": 0,
                    "max": 7,
                    "adjust_for_weather": true
                },
                "minecraft:difficulty_filter": {
                    "min": "easy",
                    "max": "hard"
                },
                "minecraft:weight": {
                    "default": 3
                },
                "minecraft:herd": {
                    "min_size": 1,
                    "max_size": 1
                },
                "minecraft:density_limit": {
                    "surface": 2
                },
                "minecraft:biome_filter": {
                    "any_of": [
                        {"test": "has_biome_tag", "operator": "==", "value": "jagged_peaks"},
                        {"test": "has_biome_tag", "operator": "==", "value": "frozen_peaks"},
                        {"test": "has_biome_tag", "operator": "==", "value": "snowy_slopes"},
                        {"test": "has_biome_tag", "operator": "==", "value": "plateau"},
                        {"test": "has_biome_tag", "operator": "==", "value": "mesa"},
                        {"test": "has_biome_tag", "operator": "==", "value": "taiga"}
                    ]
                }
            }
        ]
    }
}
