            },
            "minecraft:nameable": {},
            "minecraft:type_family": {
                "family": [
                    "dragonkin",
                    "monster",
                    "mob",
                    "fycq"
                ]
            },
            "minecraft:loot": {
                "table": "loot_tables/fycq/dragon_priest.json"
            },
            "minecraft:health": {
                "value": 60,
                "max": 60
            },
            "minecraft:attack": {
                "damage": 5
            },
            "minecraft:collision_box": {
                "width": 0.7,
                "height": 1.9
            },
            "minecraft:movement": {
                "value": 0.24
            },
            "minecraft:knockback_resistance": {
                "value": 0.3
            },
            "minecraft:physics": {
                "has_gravity": true,
                "has_collision": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": false
            },
            "minecraft:breathable": {
                "total_supply": 30,
                "suffocate_time": 0
            },
            "minecraft:navigation.walk": {
                "can_path_over_water": true,
                "avoid_water": false
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "must_see": true,
                "reselect_targets": true,
                "entity_types": [
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        "max_dist": 20
                    }
                ]
            },
            "minecraft:behavior.delayed_attack": {
                "priority": 5,
                "reach_multiplier": 2.0,
                "attack_duration": 0.5,
                "hit_delay_pct": 0.6,
                "track_target": true,
                "sound_event": "attack.strong"
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "xz_dist": 10,
                "y_dist": 3,
                "speed_multiplier": 0.7
            },
            "minecraft:behavior.look_at_player": {
                "priority": 8,
                "look_distance": 8.0,
                "probability": 0.05
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:ambient_sound_interval": {
                "value": 12.0,
                "range": 12.0,
                "event_name": "ambient"
            },
            "minecraft:shooter": {
                "def": "minecraft:fireball"
            },
            "minecraft:behavior.ranged_attack": {
                "priority": 3,
                "burst_shoot_count": 1,
                "burst_interval": 0.5,
